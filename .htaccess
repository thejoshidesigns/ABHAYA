# Abhaya Behavioral Health - Apache configuration for GoDaddy shared hosting
# Static site: no server-side runtime required.

# --- Error pages ---
ErrorDocument 404 /404.html

# --- Directory hardening ---
Options -Indexes -MultiViews

# --- Legacy URL redirects ---
# testimonials.html was renamed to care.html (principles page, not reviews)
Redirect 301 /testimonials.html /care.html

# --- Security headers (safe defaults for a static site) ---
# Full explanation of every directive, and the rollback procedure if the site
# returns HTTP 500 after an upload, are in SECURITY-HEADERS.md.
# Emergency rollback: rename this file to htaccess.broken in cPanel File
# Manager (enable "Show Hidden Files" first). The site returns immediately.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"

  # HSTS is intentionally DISABLED until HTTPS is verified on the live domain.
  # HSTS is cached by browsers for its configured max-age. It can be revoked by
  # serving max-age=0, but previously cached policies may remain until the
  # browser receives that response. Preloading requires a separate removal
  # process. Enable only after step 5 of DEPLOYMENT-CHECKLIST.md passes, and
  # start with a short max-age.
  # Header always set Strict-Transport-Security "max-age=300" env=HTTPS

  # Content Security Policy.
  #
  # Fonts and GSAP are self-hosted (assets/fonts/, assets/js/vendor/), so
  # fonts.googleapis.com, fonts.gstatic.com and cdn.jsdelivr.net have all been
  # removed. Do not add them back: re-adding an origin re-opens it for every
  # page, not just the one that needed it.
  #
  # Remaining third-party origins, in full:
  #   www.google.com / maps.google.com - frame-src only, for the click-to-load
  #                                      map on contact.html. Nothing is
  #                                      requested until the visitor presses
  #                                      "Load interactive map".
  #   api.web3forms.com                - form delivery (not yet active)
  #
  # 'unsafe-inline' remains on style-src only, for the inline style="..."
  # attributes still present in the markup. There is no 'unsafe-inline' or
  # 'unsafe-eval' for scripts: all JavaScript lives in external files under
  # assets/js/. Do not add either to fix a console error; add the specific
  # origin instead.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://api.web3forms.com; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com; frame-src https://www.google.com https://maps.google.com; upgrade-insecure-requests"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Cache control ---
# IMPORTANT: filenames here are NOT content-hashed or versioned. styles.css is
# always styles.css. Long "immutable" caching would therefore strand visitors
# on stale CSS/JS after an update, with no way to bust it short of renaming
# files. So caching is deliberately conservative: short lifetimes plus
# revalidation, which still avoids most re-downloads via 304s.
#
# If the build ever emits hashed filenames (styles.a1b2c3.css), the CSS/JS
# lifetimes below can safely be raised to a year with "immutable".
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  # Font binaries are the one safe exception: they are third-party releases
  # that are replaced by adding a file, never by editing one in place.
  ExpiresByType font/woff2 "access plus 180 days"
</IfModule>

<IfModule mod_headers.c>
  # HTML must always be revalidated so content and clinical corrections are
  # never served from a stale cache.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Unhashed CSS/JS: cacheable, but revalidated once the hour is up.
  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(svg|webp|jpe?g|png|ico)$">
    Header always set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header always set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>


# --- Block access to sensitive files ---
# Defence in depth: scripts/check-dist.js already prevents these from being
# built into dist/, but this blocks them if one is ever uploaded by hand.
<FilesMatch "^(\.|package\.json|package-lock\.json|bun\.lock|build\.js|README|\.env)">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|json|lock|log|bak|orig|map|ts|sh|yml|yaml)$">
  Require all denied
</FilesMatch>
# ...but the manifest, sitemap and site config must stay reachable.
<FilesMatch "^(sitemap\.xml|robots\.txt|site\.webmanifest|manifest\.json)$">
  Require all granted
</FilesMatch>
