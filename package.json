{
  "name": "abhaya-behavioral-health",
  "version": "2.0.0",
  "description": "Abhaya Behavioral Health — static site",
  "scripts": {
    "build": "node build.js && node scripts/check-contact.js",
    "build:dev": "node build.js && node scripts/check-contact.js",
    "start": "npx http-server dist -c-1 --silent",
    "dev": "npx http-server . -c-1",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "check:contact": "node scripts/check-contact.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "html-validate": "^11.6.0",
    "prettier": "^3.3.3"
  },
  "private": true
}
