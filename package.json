{
  "name": "abhaya-behavioral-health",
  "version": "2.0.0",
  "description": "Abhaya Behavioral Health static website",
  "scripts": {
    "build": "node build.js && node scripts/check-contact.js",
    "build:dev": "node build.js && node scripts/check-contact.js",
    "start": "npx http-server dist -c-1 --silent",
    "serve": "npx http-server dist -c-1",
    "dev": "node build.js && npx http-server dist -c-1",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "check:contact": "node scripts/check-contact.js",
    "preview": "node build.js && npx http-server dist -c-1",
    "check:content": "node scripts/check-content.js",
    "check:links": "node scripts/check-links.js",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:dist": "node scripts/check-dist.js",
    "test:unit": "node --test tests/*.test.js",
    "test:a11y": "playwright test tests/e2e/a11y.spec.js",
    "test:responsive": "playwright test tests/e2e/responsive.spec.js",
    "test": "npm run test:unit && npm run test:a11y && npm run test:responsive",
    "check": "npm run build && npm run check:content && npm run check:links && npm run check:html && npm run test:unit && npm run test:a11y && npm run test:responsive && npm run check:dist",
    "check:deps": "node scripts/check-deps.js",
    "prelaunch": "npm run check:deps && npm run check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "html-validate": "^11.6.0",
    "prettier": "^3.3.3"
  },
  "private": true
}
